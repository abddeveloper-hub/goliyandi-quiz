rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Participants & Leaderboard - real-time multi-device sync
    match /participants/{participantId} {
      allow read, write: if true;
    }
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Quiz state & sessions
    match /quiz_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Quiz Question Bank & Custom Questions
    match /quiz_bank/{bankId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
